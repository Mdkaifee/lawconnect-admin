# Rishikesh Law Hub - Backend Environment Configuration
PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/law-hub?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_change_in_production
CORS_ORIGIN=https://rishikesh-law-hub-admin.onrender.com

# Admin Account Credentials
ADMIN_USERNAME=Rishikesh
ADMIN_PASSWORD=Rishikesh@1

# Indian Kanoon API Integration (Optional / Server-side only)
# Get key from: https://api.indiankanoon.org/
INDIAN_KANOON_API_KEY=your_indian_kanoon_api_token_here

# Community chat unlock after this many sent messages in each conversation
CHAT_MESSAGE_FREE_LIMIT=5
CHAT_UNLOCK_AMOUNT=11
PAID_CHAT_MONTHS=3
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI chat (keys are server-side only)
AI_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
AI_PROVIDER=claude
